# Layanan penghitung pengunjung.
#
# Bawaannya memakai Abacus (https://abacus.jasoncameron.dev) — layanan
# penghitung publik yang tidak memerlukan kunci API sama sekali, sehingga
# tidak ada rahasia apa pun yang perlu diletakkan di bundel frontend.
#
# Kedua nilai ini boleh dikosongkan; nilai bawaannya sudah berfungsi.

VITE_VISITOR_COUNTER_URL=https://abacus.jasoncameron.dev

# Ganti nilai ini untuk memulai hitungan dari nol, misalnya saat berpindah
# dari tahap uji coba ke produksi.
VITE_VISITOR_COUNTER_NAMESPACE=pokmaswas-san-dominggo
